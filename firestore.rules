rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitives & Identity Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEntityId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 64
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedSignedIn() && request.auth.token.email == 'mailtoghofur@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function hasWorkspaceAccess(workspaceId) {
      return isVerifiedSignedIn()
        && request.auth.uid == workspaceId
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function hasWorkspaceAccessAfter(workspaceId) {
      return isVerifiedSignedIn()
        && request.auth.uid == workspaceId
        && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId))
        && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // 3. Entity Validation Blueprints (called on both create and update; no existing()/diff() inside)
    function isValidWorkspace(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId',
          'ownerId',
          'clinicName',
          'ownerName',
          'ownerEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId',
          'ownerId',
          'clinicName',
          'ownerName',
          'ownerEmail',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && data.clinicName is string
        && data.clinicName.size() >= 1
        && data.clinicName.size() <= 100
        && data.ownerName is string
        && data.ownerName.size() >= 1
        && data.ownerName.size() <= 100
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTherapist(data, workspaceId, therapistId) {
      return data.keys().hasAll([
          'therapist_id',
          'ownerId',
          'workspaceId',
          'name',
          'is_active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'therapist_id',
          'ownerId',
          'workspaceId',
          'name',
          'is_active',
          'createdAt',
          'updatedAt'
        ])
        && isValidEntityId(data.therapist_id)
        && data.therapist_id == therapistId
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.is_active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidService(data, workspaceId, serviceId) {
      return data.keys().hasAll([
          'service_id',
          'ownerId',
          'workspaceId',
          'category',
          'service_name',
          'duration_minutes',
          'price',
          'allow_home_service',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'service_id',
          'ownerId',
          'workspaceId',
          'category',
          'service_name',
          'duration_minutes',
          'price',
          'allow_home_service',
          'createdAt',
          'updatedAt'
        ])
        && isValidEntityId(data.service_id)
        && data.service_id == serviceId
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 20
        && data.category in ['PIJAT', 'FACIAL']
        && data.service_name is string
        && data.service_name.size() >= 1
        && data.service_name.size() <= 120
        && data.duration_minutes is int
        && data.duration_minutes >= 15
        && data.duration_minutes <= 480
        && (data.price is int || data.price is float)
        && data.price >= 0
        && data.price <= 100000000
        && data.allow_home_service is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data, workspaceId, productId) {
      return data.keys().hasAll([
          'product_id',
          'ownerId',
          'workspaceId',
          'product_name',
          'price',
          'is_active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'product_id',
          'ownerId',
          'workspaceId',
          'product_name',
          'price',
          'is_active',
          'createdAt',
          'updatedAt'
        ])
        && isValidEntityId(data.product_id)
        && data.product_id == productId
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.product_name is string
        && data.product_name.size() >= 1
        && data.product_name.size() <= 120
        && (data.price is int || data.price is float)
        && data.price >= 0
        && data.price <= 100000000
        && data.is_active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data, workspaceId, bookingId) {
      return data.keys().hasAll([
          'booking_id',
          'ownerId',
          'workspaceId',
          'patient_name',
          'patient_phone',
          'service_id',
          'therapist_id',
          'booking_date',
          'start_time',
          'end_time',
          'location_type',
          'patient_address',
          'notes',
          'status',
          'is_loyalty_reward',
          'discount_percent',
          'discount_amount',
          'final_price',
          'receipt_revised_at',
          'receipt_revision_reason',
          'created_at_iso',
          'updated_at_iso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'booking_id',
          'ownerId',
          'workspaceId',
          'patient_name',
          'patient_phone',
          'service_id',
          'therapist_id',
          'booking_date',
          'start_time',
          'end_time',
          'location_type',
          'patient_address',
          'notes',
          'status',
          'is_loyalty_reward',
          'discount_percent',
          'discount_amount',
          'final_price',
          'receipt_revised_at',
          'receipt_revision_reason',
          'created_at_iso',
          'updated_at_iso',
          'createdAt',
          'updatedAt'
        ])
        && isValidEntityId(data.booking_id)
        && data.booking_id == bookingId
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.patient_name is string
        && data.patient_name.size() >= 1
        && data.patient_name.size() <= 120
        && data.patient_phone is string
        && data.patient_phone.size() >= 6
        && data.patient_phone.size() <= 32
        && data.patient_phone.matches('^[0-9+]+$')
        && isValidEntityId(data.service_id)
        && isValidEntityId(data.therapist_id)
        && data.booking_date is string
        && data.booking_date.size() == 10
        && data.booking_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.start_time is string
        && data.start_time.size() == 5
        && data.start_time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.end_time is string
        && data.end_time.size() == 5
        && data.end_time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.location_type is string
        && data.location_type.size() >= 1
        && data.location_type.size() <= 20
        && data.location_type in ['CLINIC', 'HOME_SERVICE']
        && data.patient_address is string
        && data.patient_address.size() <= 300
        && data.notes is string
        && data.notes.size() <= 500
        && data.status is string
        && data.status.size() >= 1
        && data.status.size() <= 20
        && data.status in ['SCHEDULED', 'COMPLETED', 'CANCELLED']
        && data.is_loyalty_reward is bool
        && data.discount_percent is int
        && data.discount_percent in [0, 10, 20]
        && (data.discount_amount is int || data.discount_amount is float)
        && data.discount_amount >= 0
        && data.discount_amount <= 100000000
        && (data.final_price is int || data.final_price is float)
        && data.final_price >= 0
        && data.final_price <= 100000000
        && data.receipt_revised_at is string
        && data.receipt_revised_at.size() <= 40
        && data.receipt_revision_reason is string
        && data.receipt_revision_reason.size() <= 300
        && data.created_at_iso is string
        && data.created_at_iso.size() >= 1
        && data.created_at_iso.size() <= 40
        && data.updated_at_iso is string
        && data.updated_at_iso.size() >= 1
        && data.updated_at_iso.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProductSale(data, workspaceId, saleId) {
      return data.keys().hasAll([
          'sale_id',
          'ownerId',
          'workspaceId',
          'product_id',
          'product_name',
          'therapist_id',
          'buyer_name',
          'quantity',
          'unit_price',
          'total_amount',
          'sale_date',
          'notes',
          'status',
          'created_at_iso',
          'updated_at_iso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'sale_id',
          'ownerId',
          'workspaceId',
          'product_id',
          'product_name',
          'therapist_id',
          'buyer_name',
          'quantity',
          'unit_price',
          'total_amount',
          'sale_date',
          'notes',
          'status',
          'created_at_iso',
          'updated_at_iso',
          'createdAt',
          'updatedAt'
        ])
        && isValidEntityId(data.sale_id)
        && data.sale_id == saleId
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidEntityId(data.product_id)
        && data.product_name is string
        && data.product_name.size() >= 1
        && data.product_name.size() <= 120
        && isValidEntityId(data.therapist_id)
        && data.buyer_name is string
        && data.buyer_name.size() >= 1
        && data.buyer_name.size() <= 120
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 1000
        && (data.unit_price is int || data.unit_price is float)
        && data.unit_price >= 0
        && data.unit_price <= 100000000
        && (data.total_amount is int || data.total_amount is float)
        && data.total_amount >= 0
        && data.total_amount <= 1000000000
        && data.sale_date is string
        && data.sale_date.size() == 10
        && data.sale_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.notes is string
        && data.notes.size() <= 500
        && data.status is string
        && data.status.size() >= 1
        && data.status.size() <= 20
        && data.status in ['COMPLETED', 'CANCELLED']
        && data.created_at_iso is string
        && data.created_at_iso.size() >= 1
        && data.created_at_iso.size() <= 40
        && data.updated_at_iso is string
        && data.updated_at_iso.size() >= 1
        && data.updated_at_iso.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Connection Validation Document (no sensitive data)
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // 5. System Admins Collection
    match /admins/{uid} {
      allow get: if isValidId(uid) && isVerifiedSignedIn() && (isOwner(uid) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if isValidId(uid) && isBootstrappedAdmin();
    }

    // 6. Clinic Workspaces (PII isolated to owner or verified system admin)
    match /workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && isVerifiedSignedIn() && (isOwner(workspaceId) || isAdmin());
      allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedSignedIn()
        && isValidId(workspaceId)
        && isValidWorkspace(incoming(), workspaceId)
        && isOwner(workspaceId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedSignedIn()
        && isValidId(workspaceId)
        && isValidWorkspace(incoming(), workspaceId)
        && (isOwner(workspaceId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['clinicName', 'ownerName', 'updatedAt'])
          || isAdmin()
        );
      allow delete: if isValidId(workspaceId) && isVerifiedSignedIn() && (isOwner(workspaceId) || isAdmin());

      // 6a. Therapists Subcollection
      match /therapists/{therapistId} {
        allow get: if isValidId(workspaceId) && isValidEntityId(therapistId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
        allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
        allow create: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(therapistId)
          && isValidTherapist(incoming(), workspaceId, therapistId)
          && (hasWorkspaceAccessAfter(workspaceId) || isAdmin())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(therapistId)
          && isValidTherapist(incoming(), workspaceId, therapistId)
          && (hasWorkspaceAccess(workspaceId) || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().workspaceId == existing().workspaceId
          && incoming().therapist_id == existing().therapist_id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'is_active', 'updatedAt'])
            || isAdmin()
          );
        allow delete: if isValidId(workspaceId) && isValidEntityId(therapistId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
      }

      // 6b. Services Subcollection
      match /services/{serviceId} {
        allow get: if isValidId(workspaceId) && isValidEntityId(serviceId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
        allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
        allow create: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(serviceId)
          && isValidService(incoming(), workspaceId, serviceId)
          && (hasWorkspaceAccessAfter(workspaceId) || isAdmin())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(serviceId)
          && isValidService(incoming(), workspaceId, serviceId)
          && (hasWorkspaceAccess(workspaceId) || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().workspaceId == existing().workspaceId
          && incoming().service_id == existing().service_id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'category',
              'service_name',
              'duration_minutes',
              'price',
              'allow_home_service',
              'updatedAt'
            ])
            || isAdmin()
          );
        allow delete: if isValidId(workspaceId) && isValidEntityId(serviceId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
      }

      // 6c. Products Subcollection
      match /products/{productId} {
        allow get: if isValidId(workspaceId) && isValidEntityId(productId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
        allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
        allow create: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(productId)
          && isValidProduct(incoming(), workspaceId, productId)
          && (hasWorkspaceAccessAfter(workspaceId) || isAdmin())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(productId)
          && isValidProduct(incoming(), workspaceId, productId)
          && (hasWorkspaceAccess(workspaceId) || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().workspaceId == existing().workspaceId
          && incoming().product_id == existing().product_id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['product_name', 'price', 'is_active', 'updatedAt'])
            || isAdmin()
          );
        allow delete: if isValidId(workspaceId) && isValidEntityId(productId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
      }

      // 6d. Bookings Subcollection (PII isolated, referential integrity, terminal state locking + receipt revision)
      match /bookings/{bookingId} {
        allow get: if isValidId(workspaceId) && isValidEntityId(bookingId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
        allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
        allow create: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(bookingId)
          && isValidBooking(incoming(), workspaceId, bookingId)
          && (hasWorkspaceAccessAfter(workspaceId) || isAdmin())
          && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/services/$(incoming().service_id))
          && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/therapists/$(incoming().therapist_id))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(bookingId)
          && isValidBooking(incoming(), workspaceId, bookingId)
          && (hasWorkspaceAccess(workspaceId) || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().workspaceId == existing().workspaceId
          && incoming().booking_id == existing().booking_id
          && incoming().createdAt == existing().createdAt
          && incoming().created_at_iso == existing().created_at_iso
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/services/$(incoming().service_id))
          && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/therapists/$(incoming().therapist_id))
          && (
            (
              // Action: Reschedule while still SCHEDULED
              existing().status == 'SCHEDULED'
              && incoming().status == 'SCHEDULED'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'patient_name',
                'patient_phone',
                'service_id',
                'therapist_id',
                'booking_date',
                'start_time',
                'end_time',
                'location_type',
                'patient_address',
                'notes',
                'updated_at_iso',
                'updatedAt'
              ])
            )
            || (
              // Action: Complete or Cancel treatment from SCHEDULED
              existing().status == 'SCHEDULED'
              && incoming().status in ['COMPLETED', 'CANCELLED']
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status',
                'discount_percent',
                'discount_amount',
                'final_price',
                'updated_at_iso',
                'updatedAt'
              ])
            )
            || (
              // Action: Post-completion receipt correction (Perbaikan Resi, preserves COMPLETED status)
              existing().status == 'COMPLETED'
              && incoming().status == 'COMPLETED'
              && incoming().receipt_revised_at.size() > 0
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'patient_name',
                'patient_phone',
                'service_id',
                'therapist_id',
                'booking_date',
                'start_time',
                'end_time',
                'location_type',
                'patient_address',
                'notes',
                'discount_percent',
                'discount_amount',
                'final_price',
                'receipt_revised_at',
                'receipt_revision_reason',
                'updated_at_iso',
                'updatedAt'
              ])
            )
            || isAdmin()
          );
        allow delete: if isValidId(workspaceId) && isValidEntityId(bookingId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
      }

      // 6e. Product Sales Subcollection
      match /product_sales/{saleId} {
        allow get: if isValidId(workspaceId) && isValidEntityId(saleId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
        allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
        allow create: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(saleId)
          && isValidProductSale(incoming(), workspaceId, saleId)
          && (hasWorkspaceAccessAfter(workspaceId) || isAdmin())
          && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/products/$(incoming().product_id))
          && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/therapists/$(incoming().therapist_id))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedSignedIn()
          && isValidId(workspaceId)
          && isValidEntityId(saleId)
          && isValidProductSale(incoming(), workspaceId, saleId)
          && (hasWorkspaceAccess(workspaceId) || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().workspaceId == existing().workspaceId
          && incoming().sale_id == existing().sale_id
          && incoming().createdAt == existing().createdAt
          && incoming().created_at_iso == existing().created_at_iso
          && incoming().updatedAt == request.time
          && (
            (
              // Action: Cancel completed product sale (Terminal state locking: CANCELLED cannot revert)
              existing().status == 'COMPLETED'
              && incoming().status == 'CANCELLED'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status',
                'updated_at_iso',
                'updatedAt'
              ])
            )
            || isAdmin()
          );
        allow delete: if isValidId(workspaceId) && isValidEntityId(saleId) && (hasWorkspaceAccess(workspaceId) || isAdmin());
      }
    }
  }
}
