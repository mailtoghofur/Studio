{
  "entities": {
    "SystemMeta": {
      "title": "SystemMeta",
      "description": "Metadata inisialisasi akun Admin Master klinik.",
      "type": "object",
      "properties": {
        "initialized": { "type": "boolean" },
        "masterUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["initialized", "masterUid", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Catatan hak akses Admin di Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isMaster": { "type": "boolean" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "isMaster", "workspaceId", "createdAt"]
    },
    "UserAccountProfile": {
      "title": "UserAccountProfile",
      "description": "Profil akun dan peran Admin atau Terapis tanpa data pribadi sensitif.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 50, "pattern": "^[a-zA-Z0-9._\\-]+$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["ADMIN", "THERAPIST"] },
        "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "therapist_id": { "type": "string", "minLength": 0, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "is_active": { "type": "boolean" },
        "is_master": { "type": "boolean" },
        "created_by_uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "display_name", "role", "workspace_id", "is_active", "is_master", "created_by_uid", "created_at", "updated_at"]
    },
    "ClinicWorkspace": {
      "title": "ClinicWorkspace",
      "description": "Ruang kerja database klinik milik seorang Admin.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUsername": { "type": "string", "minLength": 3, "maxLength": 50, "pattern": "^[a-zA-Z0-9._\\-]+$" },
        "clinicName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "adminUids": { "type": "array", "description": "Daftar UID admin ruang kerja (maks 10)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "ownerUid", "ownerUsername", "clinicName", "adminUids", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Keanggotaan akun Admin atau Terapis di dalam ruang kerja klinik.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "owner_uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "admin_uids": { "type": "array", "description": "Daftar UID admin ruang kerja (maks 10)." },
        "username": { "type": "string", "minLength": 3, "maxLength": 50, "pattern": "^[a-zA-Z0-9._\\-]+$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["ADMIN", "THERAPIST"] },
        "therapist_id": { "type": "string", "minLength": 0, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "is_active": { "type": "boolean" },
        "is_master": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "owner_uid", "admin_uids", "username", "display_name", "role", "is_active", "is_master", "updatedAt"]
    },
    "TherapistsCatalog": {
      "title": "TherapistsCatalog",
      "description": "Daftar terapis di dalam ruang kerja klinik.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array", "description": "Daftar objek terapis (maks 50)." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "items", "updatedAt"]
    },
    "ServicesCatalog": {
      "title": "ServicesCatalog",
      "description": "Katalog layanan pijat dan facial di dalam ruang kerja klinik.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array", "description": "Daftar objek layanan (maks 100)." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "items", "updatedAt"]
    },
    "ClinicBooking": {
      "title": "ClinicBooking",
      "description": "Reservasi jadwal pasien di ruang kerja klinik.",
      "type": "object",
      "properties": {
        "booking_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "owner_uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "admin_uids": { "type": "array", "description": "Daftar UID admin ruang kerja (maks 10)." },
        "therapist_uid": { "type": "string", "minLength": 0, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "patient_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "patient_phone": { "type": "string", "minLength": 8, "maxLength": 20, "pattern": "^62[0-9]{6,16}$" },
        "service_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "therapist_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "booking_date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "start_time": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "end_time": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "location_type": { "type": "string", "enum": ["CLINIC", "HOME_SERVICE"] },
        "patient_address": { "type": "string", "minLength": 0, "maxLength": 300 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 400 },
        "status": { "type": "string", "enum": ["SCHEDULED", "COMPLETED", "CANCELLED"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "booking_id",
        "workspace_id",
        "owner_uid",
        "admin_uids",
        "therapist_uid",
        "patient_name",
        "patient_phone",
        "service_id",
        "therapist_id",
        "booking_date",
        "start_time",
        "end_time",
        "location_type",
        "patient_address",
        "notes",
        "status",
        "created_at",
        "updated_at"
      ]
    }
  },
  "firestore": {
    "/system/{docId}": {
      "schema": { "$ref": "#/entities/SystemMeta" },
      "description": "Status inisialisasi akun Admin Master."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Daftar UID Admin yang terverifikasi."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccountProfile" },
      "description": "Profil akun dan peran pengguna."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/ClinicWorkspace" },
      "description": "Dokumen induk ruang kerja database klinik."
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Anggota ruang kerja klinik."
    },
    "/workspaces/{workspaceId}/config/therapists": {
      "schema": { "$ref": "#/entities/TherapistsCatalog" },
      "description": "Katalog terapis klinik."
    },
    "/workspaces/{workspaceId}/config/services": {
      "schema": { "$ref": "#/entities/ServicesCatalog" },
      "description": "Katalog layanan pijat dan facial klinik."
    },
    "/workspaces/{workspaceId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/ClinicBooking" },
      "description": "Data reservasi jadwal pasien."
    }
  }
}
